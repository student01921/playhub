# Copy this file to .env.local and fill in your Supabase project values.
# The app builds and runs without these values; account and online-room
# features show a setup notice until Supabase is connected.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=GatherPlay

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add the service-role key here. This app does not use it at runtime.
